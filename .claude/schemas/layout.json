{
  "title": "Vigil workspace layout",
  "description": "Every path an agent may write, with the schema each JSON/JSONL file must satisfy. `*` matches one path segment, `**` matches any depth. First match wins, so specific rules come first. The write-guard and validate scripts both read this file.",
  "paths": [
    { "pattern": "company-profile/*/details.json", "schema": "company-details.schema.json", "description": "Organisation details and registrations" },
    { "pattern": "company-profile/*/data-map.json", "schema": "data-map.schema.json", "description": "Personal data inventory and data flow map" },
    { "pattern": "company-profile/*/consent-records/*.json", "schema": "consent-record.schema.json", "description": "Consent collection and withdrawal records" },
    { "pattern": "company-profile/*/dpias/*.json", "schema": "dpia.schema.json", "description": "Data Protection Impact Assessments" },
    { "pattern": "company-profile/*/dpias/*.md", "description": "DPIA narrative reports" },
    { "pattern": "company-profile/*/breach-log.jsonl", "schema": "breach-entry.schema.json", "append_only": true, "description": "Append-only breach and incident log" },
    { "pattern": "company-profile/*/rights-log.jsonl", "schema": "rights-entry.schema.json", "append_only": true, "description": "Append-only Data Principal / data subject rights log" },
    { "pattern": "company-profile/*/posture.json", "schema": "posture.schema.json", "description": "Current compliance posture snapshot" },
    { "pattern": "company-profile/.gitkeep", "description": "Keeps the empty directory in git" },
    { "pattern": "assessments/*/report.json", "schema": "report.schema.json", "description": "Audit findings for one assessment" },
    { "pattern": "assessments/*/posture.json", "schema": "posture.schema.json", "description": "Posture snapshot taken during the assessment" },
    { "pattern": "assessments/*/data-map.json", "schema": "data-map.schema.json", "description": "Data map captured during the assessment" },
    { "pattern": "assessments/*/**", "description": "Summaries, remediation plans and other assessment artefacts" },
    { "pattern": "kpis/**", "description": "KPI definitions, raw session data and computed metrics" },
    { "pattern": "examples/**", "description": "Consent notice templates, sector guides and a synthetic app to audit" },
    { "pattern": ".claude/skills/**", "description": "Skills. Hooks, schemas and settings are left out on purpose: agents must not edit their own guards" },
    { "pattern": ".github/**", "description": "CI workflows and issue templates" },
    { "pattern": "docs/**", "description": "Documentation and images" },
    { "pattern": "aranya/**", "description": "Aranya: self-contained environmental-law sub-project staged inside this repo; has its own layout, schemas and validation" },
    { "pattern": "README.md" },
    { "pattern": "CLAUDE.md" },
    { "pattern": "AGENTS.md" },
    { "pattern": "CONTRIBUTING.md" },
    { "pattern": "SECURITY.md" },
    { "pattern": "CHANGELOG.md" },
    { "pattern": "CITATION.cff" },
    { "pattern": "LICENSE" },
    { "pattern": ".gitignore" },
    { "pattern": ".gitattributes" },
    { "pattern": ".editorconfig" }
  ]
}
